<resources>
    <style name="Theme.Arnold" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/arnold_bg</item>
        <item name="android:colorBackground">@color/arnold_bg</item>
    </style>

    <style name="Theme.Arnold.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/arnold_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_empty</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.Arnold</item>
    </style>
</resources>
